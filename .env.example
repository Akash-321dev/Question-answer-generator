# EduGenAI Environment Variables Example

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000

# SQLite Database URL
DATABASE_URL=sqlite:///./edugenai.db

# Vector Index Storage Directory
VECTOR_STORE_DIR=./vector_stores

# Local Sentence Transformer Embedding Model (HuggingFace model ID)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Local Ollama REST API Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3
OLLAMA_TIMEOUT=120.0

# Optional Gemini API fallback (if using cloud AI)
GEMINI_API_KEY=""
